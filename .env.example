DATABASE_URL=postgresql://pathquote:CHANGE_ME@postgres:5432/pathquote
# must match the password inside DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://q.pathfindercut.com
AUTH_TRUST_HOST=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# Resend SMTP: user is the literal string "resend", pass is the API key
SMTP_USER=resend
SMTP_PASS=re_CHANGE_ME_resend_api_key
EMAIL_FROM="PathQuote <noreply@q.pathfindercut.com>"
# Fallback Reply-To. EMAIL_FROM is on the Resend sending subdomain and
# receives nothing, so client replies need a real mailbox. Quote emails
# prefer the manager who authored the quote and only land here when that
# author is missing or deactivated. Blank = send no Reply-To header.
EMAIL_REPLY_TO=sales@pathfindercut.com
GOTENBERG_URL=http://gotenberg:3000
UPLOADS_DIR=/data/uploads
