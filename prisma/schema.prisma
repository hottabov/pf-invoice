generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

enum DocumentStatus {
  DRAFT
  FINAL
}

enum LineKind {
  OPTION
  PRODUCT
  CUSTOM
}

// A discount is a mode plus a value rather than a bare percentage — see
// Document.discountMode/DocumentItem.discountMode below. Storing a mode
// (instead of two nullable columns, one per shape) makes "both set and
// disagreeing" unrepresentable. Migration z12_discount_mode renamed the old
// discountPct column to discountValue and widened it from Decimal(5,2) to
// Decimal(12,2) so a cash amount isn't capped at $999.99.
enum DiscountMode {
  PERCENT
  AMOUNT
}

// An export sale collected at the factory door is not a domestic taxable
// supply -- the meeting question left unanswered ("What if there's no GST?
// If it's Ex Works?"). DELIVERED is the default so every existing document
// keeps its current (taxed) behaviour; see the zero-tax rule applied in
// recalcDocument (src/lib/actions/documents.ts), the single place a
// document's effective tax rate is resolved.
enum DeliveryTerms {
  DELIVERED
  EX_WORKS
}

model Region {
  id             String         @id @default(cuid())
  code           String         @unique // AU, US, UK
  name           String
  currency       String // AUD, USD, GBP
  taxName        String // GST, Sales Tax, VAT
  taxRate        Decimal        @db.Decimal(5, 2) // 10.00
  entityName     String // Pathfinder Australia Pty Ltd
  entityLegalId  String? // ABN 64 072 458 667
  entityAddress  String?
  bankDetails    Json?
  logoUrl        String?
  footerText     String?
  maxDiscountPct Decimal?       @db.Decimal(5, 2) // AU: 10, US: 15 -- discount cap enforced against a document's region (see setItemDiscount/setDocumentDiscount in src/lib/actions/documents.ts); not shown in the catalog UI.
  // The mirror of maxDiscountPct: how far ABOVE list a distributor may price
  // (Ross: "he's got a minimum selling price. And a maximum selling price.
  // And those rules apply to the LLC as well."). Null means no ceiling, same
  // "unset changes nothing" contract maxDiscountPct already has. Enforced
  // via the same concession machinery as the discount cap -- a negative
  // concession is a markup -- see documentConcession/recalcAndEnforce.
  maxMarkupPct   Decimal?       @db.Decimal(5, 2)
  active         Boolean        @default(true)
  users          User[]
  companies      Company[]
  prices         Price[]
  documents      Document[]
  contentBlocks  ContentBlock[]
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime?
  name           String?
  phone          String?
  image          String?
  passwordHash   String?
  role           Role       @default(MANAGER)
  regionId       String?
  region         Region?    @relation(fields: [regionId], references: [id])
  active         Boolean    @default(true)
  documents      Document[]
  accounts       Account[]
  sessions       Session[]
  companiesOwned Company[]  @relation("CompanyOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Series {
  id             String                @id @default(cuid())
  code           String                @unique // M, X, L, P, SW, LNS, EL, EF, FP, SVC
  name           String // M-Series, X-Calibre...
  maxDiscountPct Decimal?              @db.Decimal(5, 2) // unused: discount caps moved to Region.maxDiscountPct; column kept, not read anywhere
  sortOrder      Int                   @default(0)
  imageUrl       String? // admin override for the /catalog series card image; null falls back to the first active product's imageUrl -- see listSeriesWithCounts in src/lib/queries/catalog.ts
  products       Product[]
  compat         OptionCompatibility[]
}

model Product {
  id          String                @id @default(cuid())
  code        String                @unique // M5180
  seriesId    String
  series      Series                @relation(fields: [seriesId], references: [id])
  name        String
  description String?
  specs       Json? // { cutHeightCm, widthCm, ... }
  imageUrl    String?
  active      Boolean               @default(true)
  sortOrder   Int                   @default(0)
  // A credit product (today: the TRADE-IN catalogue product -- John: "we
  // should create another product called trade-in, so that way the
  // terminology is correct... it's a line item. It's a product. You're
  // selling a trade in. It's a negative value") subtracts its amount from a
  // quote instead of adding it. Deliberately NOT a negative unitPrice on the
  // item -- a salesperson always types a positive number here, and only the
  // reader of this flag (the pricing engine's sign, and the sheets'
  // rendering) ever treats it as a reduction. That keeps "sell a trade-in
  // for $20,000" and "accidentally type $20,000 instead of -$20,000" simply
  // not the same mistake anymore: a credit item's arithmetic sign comes from
  // the product, never from what was typed. See the doc comment on
  // `EngineItem.isCredit` in src/lib/pricing.ts for how this is consumed.
  // Migration z16_product_is_credit adds this column with its default, so
  // every existing product is unaffected.
  isCredit    Boolean               @default(false)
  prices      Price[]
  compat      OptionCompatibility[]
  docItems    DocumentItem[]
}

model Option {
  id               String                @id @default(cuid())
  code             String                @unique // MTS, HFV, VRB-180...
  name             String
  shortDescription String?
  attributeSchema  Json? // e.g. [{key:"metres",label:"Travel (m)",type:"number"}]
  imageUrl         String?
  active           Boolean               @default(true)
  sortOrder        Int                   @default(0)
  prices           Price[]
  compat           OptionCompatibility[]
}

model OptionCompatibility {
  id        String   @id @default(cuid())
  optionId  String
  option    Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  seriesId  String? // compatible with whole series
  series    Series?  @relation(fields: [seriesId], references: [id])
  productId String? // or a specific product
  product   Product? @relation(fields: [productId], references: [id])

  @@unique([optionId, seriesId, productId])
}

model Price {
  id          String   @id @default(cuid())
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId    String?
  option      Option?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  needsReview Boolean  @default(false) // imported gaps: M3390 TBD etc.

  @@unique([productId, regionId])
  @@unique([optionId, regionId])
  @@index([regionId])
}

model Company {
  id       String  @id @default(cuid())
  name     String
  street   String?
  city     String?
  state    String?
  postcode String?
  country  String? // ISO 3166-1 alpha-2 code going forward (see src/lib/countries.ts); pre-migration rows may still hold free text -- rendered via displayCountry().
  website  String?
  taxId    String?
  notes    String?

  // Delivery address: manufacturing/warehouse site, distinct from the main
  // (billing/office) address above -- owner: "client office is not always
  // the manufacturing site; delivery address matters." `deliverySameAsMain`
  // defaults true so the common case (one address) needs no extra input;
  // the delivery* fields below are only meaningful when it's false, and are
  // left populated-but-ignored if a company later flips back to true rather
  // than being cleared, so re-enabling "different address" restores the
  // previous entry instead of losing it.
  deliverySameAsMain  Boolean @default(true)
  deliveryStreet      String?
  deliveryCity        String?
  deliveryState       String?
  deliveryPostcode    String?
  deliveryCountry     String? // ISO 3166-1 alpha-2 code, same convention as `country`.
  deliveryContactName String?
  deliveryPhone       String? // Stored E.164 when parseable (see validatePhone in src/lib/phone.ts), raw otherwise.
  deliveryNotes       String?

  regionId   String
  region     Region     @relation(fields: [regionId], references: [id])
  ownerId    String?
  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id])
  industryId String?
  industry   Industry?  @relation(fields: [industryId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  documents  Document[]
  createdAt  DateTime   @default(now())

  @@index([ownerId])
  @@index([industryId]) // renaming an industry shows an affected-company count first ("Used by 14 companies"), counted by industryId
}

model Contact {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String?
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean    @default(false)
  documents Document[]

  @@index([companyId])
}

// Lookup table rather than free text on Company: the list is bulk-imported
// (scripts/import-industries.ts) and picked hundreds of times, so an
// industry has to be one row every company points at instead of a string
// repeated with drifting spellings -- that is what makes the inline rename
// in industry-picker.tsx a real fix rather than a per-company patch.
// Global, not per-region: an industry means the same thing in AU and US.
model Industry {
  id        String    @id @default(cuid())
  name      String    @unique // Case-insensitive uniqueness is enforced by a separate functional index (Industry_name_lower_key) in the 10_industry_and_production_spec migration -- Prisma cannot declare that, so @unique alone is not the whole story.
  companies Company[]
}

model Document {
  id               String         @id @default(cuid())
  status           DocumentStatus @default(DRAFT)
  number           String?        @unique // Q-AU-2026-001, assigned on finalize
  companyId        String? // set once the client step of the builder is completed
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId        String?
  contact          Contact?       @relation(fields: [contactId], references: [id])
  authorId         String
  author           User           @relation(fields: [authorId], references: [id])
  regionId         String
  region           Region         @relation(fields: [regionId], references: [id])
  issueDate        DateTime       @default(now())
  validityDays     Int?
  currency         String
  taxName          String
  taxRate          Decimal        @db.Decimal(5, 2)
  // DELIVERED (default) or EX_WORKS -- an Ex Works quote's tax is zeroed by
  // recalcDocument (src/lib/actions/documents.ts), the single caller that
  // resolves a document's effective tax rate; taxName/taxRate above are left
  // untouched (they're the region's nominal figures, unrelated to this
  // per-document override). finalizeDocument freezes nothing new for this --
  // the terms live on the document itself, not the entitySnapshot.
  deliveryTerms    DeliveryTerms  @default(DELIVERED)
  entitySnapshot   Json? // frozen on finalize
  // A discount is a mode + value (see the DiscountMode enum comment above) —
  // discountValue is a plain percentage (0..100) when discountMode is
  // PERCENT, or a cash amount in the document's own currency when AMOUNT;
  // null means no discount is set, regardless of mode. Enforced against
  // Region.maxDiscountPct — see setDocumentDiscount in
  // src/lib/actions/documents.ts.
  discountMode     DiscountMode   @default(PERCENT)
  discountValue    Decimal?       @db.Decimal(12, 2)
  subtotal         Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @default(0) @db.Decimal(12, 2)
  notes            String?
  // Quotation-first pricing display (owner spec): a quote's total is always
  // shown up top regardless of these, but the per-item/per-option detail in
  // the investment summary only renders when the corresponding toggle is on
  // — see setPriceDisplay in src/lib/actions/documents.ts and
  // buildQuotationData in src/lib/quotation-data.ts.
  showItemPrices   Boolean        @default(false)
  showOptionPrices Boolean        @default(false)
  items            DocumentItem[]
  lines            DocumentLine[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([companyId])
  @@index([authorId])
  @@index([regionId, status])
}

model DocumentItem {
  id             String         @id @default(cuid())
  documentId     String
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  sortOrder      Int            @default(0)
  code           String // snapshot
  name           String // snapshot
  description    String? // snapshot
  unitPrice      Decimal        @db.Decimal(12, 2) // snapshot -- what the customer is actually charged; a salesperson can hand-edit this (see setItemUnitPrice, src/lib/actions/documents.ts), including down to 0.
  // The catalogue price at the moment this row was added -- never shown to
  // the customer, only used (alongside unitPrice above) to compute the
  // region discount-cap "concession" a manual price represents (see the
  // documentConcession comment on PricingTotals in src/lib/pricing.ts).
  // Null for a row added before this column existed; migration
  // z13_line_list_price backfills those to unitPrice so they read as "no
  // concession". Nullable rather than defaulted to unitPrice at the type
  // level so "never priced by hand" stays distinguishable in the data.
  listPrice      Decimal?       @db.Decimal(12, 2)
  // Same mode + value shape as Document.discountMode/discountValue above —
  // see the DiscountMode enum comment.
  discountMode   DiscountMode   @default(PERCENT)
  discountValue  Decimal?       @db.Decimal(12, 2)
  serialNumber   String?
  showImage      Boolean        @default(false)
  // Sales-side production choices the price list does not carry: screen side
  // (+Y/-Y), knife size, voltage, drills, EasyLoader table sections. Shape
  // varies by series -- validated by src/lib/validation/production-spec.ts,
  // never read as free-form JSON. Deliberately NOT covered by the finalize
  // lock: it carries no commercial meaning, so correcting a knife size must
  // not force an unfinalize/refinalize cycle that churns document numbering.
  productionSpec Json?
  // Production line grouping. Items sharing a value share an operator-screen
  // side -- a cutter, its EasyLoader and its FabricPro stand together and a
  // mismatched side is a physical installation fault. Defaults to 1 so the
  // single-line case never sees the field. See spec section 4.2 for why this
  // is an Int rather than a ProductionLine table.
  lineGroup      Int            @default(1)
  imageUrl       String?
  lines          DocumentLine[]

  @@index([documentId])
}

model DocumentLine {
  id          String        @id @default(cuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemId      String? // null = document-level line
  item        DocumentItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind        LineKind
  refId       String? // optionId or productId
  code        String?
  name        String
  description String?
  qty         Int           @default(1)
  unitPrice   Decimal       @db.Decimal(12, 2) // what the customer is actually charged -- see DocumentItem.unitPrice's comment; hand-editable for an OPTION line via setLineUnitPrice, not offered for a CUSTOM (extra) line, which has no catalogue price to concede against.
  // Catalogue price snapshot -- see DocumentItem.listPrice's comment. Only
  // ever populated for an OPTION line (the option's price at selection
  // time); a CUSTOM line has no catalogue entry to snapshot and stays null.
  listPrice   Decimal?      @db.Decimal(12, 2)
  attributes  Json? // { metres: 4, tables: 2 }
  showImage   Boolean       @default(false)
  // A custom extra line has no catalogue entry to inherit an image from, so
  // it carries its own (option lines keep using the catalogue image via
  // `refId`). Set together with `showImage` by `addCustomLine`.
  imageUrl    String?
  sortOrder   Int           @default(0)

  @@index([documentId])
  @@index([itemId])
}

model ContentBlock {
  id        String  @id @default(cuid())
  key       String // terms.delivery, rsp.agreement, option.MTS
  regionId  String?
  region    Region? @relation(fields: [regionId], references: [id])
  title     String?
  body      String // markdown
  sortOrder Int     @default(0)

  @@unique([key, regionId])
}

model NumberSequence {
  id         String @id @default(cuid())
  regionCode String
  year       Int
  counter    Int    @default(0)

  @@unique([regionCode, year])
}

model Setting {
  key   String @id
  value Json
}
